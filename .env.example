# Copy this file to .env for local development.
# Add the same values in Netlify for deployment. Never commit real secrets.

# Application
SITE_URL=http://localhost:8888
APP_PEPPER=replace-with-at-least-32-random-characters
DEMO_MODE=false

# Supabase (server-side access only)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_YOUR_SERVER_ONLY_KEY

# Resend email delivery
RESEND_API_KEY=re_YOUR_SERVER_ONLY_RESEND_KEY
RESEND_FROM=TIP SecurePass <portal@YOUR_VERIFIED_DOMAIN>

# Primary SMS provider: UniSMS
SMS_PROVIDER=unisms
UNISMS_BASE_URL=https://unismsapi.com/api
UNISMS_API_KEY=YOUR_SERVER_ONLY_UNISMS_KEY
UNISMS_SENDER_ID=YOUR_APPROVED_SENDER_ID
UNISMS_TRIAL_MODE=false
UNISMS_ALLOWED_PHONE=

# Optional alternative SMS provider: Infobip
INFOBIP_BASE_URL=YOUR_SUBDOMAIN.api.infobip.com
INFOBIP_API_KEY=YOUR_SERVER_ONLY_INFOBIP_KEY
INFOBIP_SMS_FROM=YOUR_APPROVED_INFOBIP_SENDER
INFOBIP_TRIAL_MODE=true
INFOBIP_TRIAL_ALLOWED_PHONE=63XXXXXXXXXX
