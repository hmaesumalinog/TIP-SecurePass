# Copy this file to .env for local development.
# Add the same values in Netlify for deployment. Never commit real secrets.

# Application
SITE_URL=http://localhost:8888
EMAIL_APP_NAME=Reset Workflow
# Shows simulated SMS codes on screen only for localhost with no SMS provider.
# A deployed site never shows codes, whatever this value is.
DEMO_MODE=false

# Server secrets: at least 32 random characters each, all different.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_PEPPER=replace-with-a-different-32-plus-character-value
RECOVERY_ENCRYPTION_KEY=replace-with-a-third-32-plus-character-value

# Supabase (server-side access only)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_YOUR_SERVER_ONLY_KEY

# Resend email delivery
RESEND_API_KEY=re_YOUR_SERVER_ONLY_RESEND_KEY
RESEND_FROM=TIP SecurePass <portal@YOUR_VERIFIED_DOMAIN>

# SMS delivery: UniSMS
SMS_PROVIDER=unisms
UNISMS_BASE_URL=https://unismsapi.com/api
UNISMS_API_KEY=YOUR_SERVER_ONLY_UNISMS_KEY
UNISMS_SENDER_ID=YOUR_APPROVED_SENDER_ID
UNISMS_TRIAL_MODE=false
UNISMS_ALLOWED_PHONE=
